# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (LOCAL)
# ==========================================

# Host del servidor (usualmente localhost en Windows/Mac)
DB_HOST=localhost

# Puerto estándar de PostgreSQL
DB_PORT=5432

# Nombre de la base de datos que creaste
DB_NAME=tesisflow_db

# Tu usuario de PostgreSQL (por defecto suele ser 'postgres')
DB_USER=postgres

# Tu contraseña de PostgreSQL
DB_PASS=tu_contraseña_aqui

# ==========================================
# NOTAS:
# 1. Asegúrate de que no haya espacios alrededor del '='
# 2. No pongas comillas en los valores a menos que contengan espacios
# ==========================================